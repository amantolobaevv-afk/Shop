# Local .env only. Render secrets belong in Environment settings.
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
# Connect > Session pooler (5432) in Supabase. URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# TLS is verified. If needed, paste Supabase's downloaded CA certificate here,
# with literal \n between lines. Never disable verification in production.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=product-images
ADMIN_PASSWORD=replace-with-a-unique-long-password
# Only set behind a trusted reverse proxy, as configured in render.yaml.
TRUST_PROXY_HOPS=0
